{
  "name": "pathclone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "sim:build": "node tools/build-sim.mjs",
    "sim:test": "cargo test --release --manifest-path sim/Cargo.toml",
    "data:pack": "node tools/pack.ts",
    "data:validate": "node tools/validate.ts",
    "gate": "node tools/shipgate.ts",
    "fuzz": "node tools/fuzz.ts",
    "determinism": "node tools/determinism.ts",
    "matrix": "node tools/matrix.ts",
    "check": "npm run data:validate && npm run sim:build && npm run data:pack && npm run gate && npm run fuzz && npm run sim:test && npm run determinism"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
